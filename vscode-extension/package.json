{
  "name": "git-triage",
  "displayName": "Git Triage",
  "description": "Git status, changes, branches, history, and credential triage in one VS Code sidebar.",
  "version": "0.1.0",
  "publisher": "ps-aditya",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Security",
    "Other"
  ],
  "keywords": [
    "gitlab",
    "security",
    "secrets",
    "git",
    "devsecops",
    "supply-chain",
    "triage",
    "scanner"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Git Triage only reads workspace files to scan for leaked credentials and hidden tasks. It does not execute repository code."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitTriage",
          "title": "Git Triage",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "gitTriage": [
        {
          "id": "gitTriage.dashboard",
          "name": "Dashboard",
          "type": "webview",
          "visibility": "visible"
        },
        {
          "id": "gitTriage.findings",
          "name": "Findings"
        }
      ]
    },
    "commands": [
      {
        "command": "gitTriage.scan",
        "title": "Git Triage: Scan Workspace",
        "icon": "$(search)"
      },
      {
        "command": "gitTriage.scanHistory",
        "title": "Git Triage: Scan Workspace + History",
        "icon": "$(history)"
      },
      {
        "command": "gitTriage.refresh",
        "title": "Git Triage: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "gitTriage.commit",
        "title": "Git Triage: Commit…",
        "icon": "$(check)"
      },
      {
        "command": "gitTriage.fetch",
        "title": "Git Triage: Fetch",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitTriage.pull",
        "title": "Git Triage: Pull",
        "icon": "$(arrow-down)"
      },
      {
        "command": "gitTriage.push",
        "title": "Git Triage: Push",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gitTriage.checkout",
        "title": "Git Triage: Checkout Branch…",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitTriage.createBranch",
        "title": "Git Triage: Create Branch…",
        "icon": "$(add)"
      },
      {
        "command": "gitTriage.init",
        "title": "Git Triage: Initialize Repository",
        "icon": "$(repo)"
      },
      {
        "command": "gitTriage.openTerminal",
        "title": "Git Triage: Open Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "gitTriage.openGitBash",
        "title": "Git Triage: Open Git Bash",
        "icon": "$(terminal-bash)"
      },
      {
        "command": "gitTriage.showDashboard",
        "title": "Git Triage: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "gitTriage.showRunbook",
        "title": "Git Triage: Show Fix Runbook",
        "icon": "$(book)"
      },
      {
        "command": "gitTriage.openSettings",
        "title": "Git Triage: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "gitTriage.showOutput",
        "title": "Git Triage: Show Output"
      },
      {
        "command": "gitTriage.openRestricted",
        "title": "Git Triage: Reload in Restricted Mode"
      },
      {
        "command": "gitTriage.openFinding",
        "title": "Git Triage: Open Finding"
      },
      {
        "command": "gitTriage.inspectTask",
        "title": "Git Triage: Inspect Folder-Open Task"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitTriage.refresh",
          "when": "view == gitTriage.dashboard",
          "group": "navigation@1"
        },
        {
          "command": "gitTriage.scan",
          "when": "view == gitTriage.dashboard",
          "group": "navigation@2"
        },
        {
          "command": "gitTriage.showRunbook",
          "when": "view == gitTriage.dashboard",
          "group": "navigation@3"
        },
        {
          "command": "gitTriage.scan",
          "when": "view == gitTriage.findings",
          "group": "navigation"
        },
        {
          "command": "gitTriage.scanHistory",
          "when": "view == gitTriage.findings",
          "group": "navigation"
        },
        {
          "command": "gitTriage.showRunbook",
          "when": "view == gitTriage.findings",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "gitTriage.openFinding",
          "when": "false"
        },
        {
          "command": "gitTriage.inspectTask",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Git Triage",
      "properties": {
        "gitTriage.scanOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Scan the workspace when the extension activates."
        },
        "gitTriage.history": {
          "type": "boolean",
          "default": false,
          "description": "Include git history in automatic scans. Manual history scans are always available from the command palette."
        },
        "gitTriage.maxCommits": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "description": "Maximum number of commits to scan when history is enabled."
        },
        "gitTriage.showProblems": {
          "type": "boolean",
          "default": true,
          "description": "Publish findings to the Problems panel."
        },
        "gitTriage.warnOnFolderOpen": {
          "type": "boolean",
          "default": true,
          "description": "Show a warning when the workspace contains a hidden folder-open task or a script disguised as an asset."
        },
        "gitTriage.pollInterval": {
          "type": "number",
          "default": 3000,
          "minimum": 1000,
          "description": "How often the dashboard refreshes Git state while it is visible, in milliseconds."
        },
        "gitTriage.logLimit": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 100,
          "description": "Number of recent commits to show in the History tab."
        },
        "gitTriage.openDashboardOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Focus the Git Triage dashboard when the extension activates."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ps-aditya/git-triage.git"
  },
  "bugs": {
    "url": "https://github.com/ps-aditya/git-triage/issues"
  },
  "homepage": "https://github.com/ps-aditya/git-triage#readme",
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --external:vscode --format=cjs --platform=node --target=node20 --outfile=dist/extension.js --sourcemap",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "test:dashboard": "node smoke-dashboard.mjs",
    "package": "npm run build && npx @vscode/vsce package --no-dependencies --out git-triage-vscode.vsix",
    "publish:ovsx": "npx ovsx publish git-triage-vscode.vsix"
  },
  "dependencies": {
    "git-triage": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.96.0",
    "esbuild": "^0.25.0",
    "jsdom": "^31.0.0",
    "typescript": "^5.6.0"
  }
}
